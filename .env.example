# ============================================
# ENVIRONNEMENT - À DUPLIER EN .env LOCAL
# ============================================
# NE PAS COMMITER .env
# Copier ce fichier vers .env et remplir les valeurs

# ---------- AUTHENTIFICATION ----------
# JWT secret : générer avec `openssl rand -base64 64`
# Minimum 64 caractères aléatoires
JWT_SECRET=change_me_openssl_rand_base64_64

# ---------- BASE DE DONNÉES ----------
# Mot de passe PostgreSQL / MySQL
# Ne jamais utiliser de mot de passe par défaut
DB_PASSWORD=change_me_strong_password_min_20_chars

# ---------- API EXTERNES ----------
# API Key pour WeLoveDevs (obtenir sur https://welovedevs.com)
# Permet d'appeler leur API métier
WELOVEDEVS_API_KEY=change_me_get_from_welovedevs_dashboard

# ---------- OPTIONNEL ----------
# Port de l'application (défaut 3000)
PORT=3000

# NODE_ENV = development | production
NODE_ENV=development