# ── API ──────────────────────────────────────────────────────
# URL de base du backend (sans slash final)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Clé API optionnelle pour les endpoints protégés
NEXT_PUBLIC_API_KEY=

# ── App ──────────────────────────────────────────────────────
# Environnement : development | production | test
NODE_ENV=development
